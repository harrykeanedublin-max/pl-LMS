# Postgres connection strings from your DB provider (e.g. Neon, Supabase).
# DATABASE_URL is the pooled connection Prisma queries through at runtime.
# DIRECT_URL is a direct (non-pooled) connection Prisma uses for migrations.
# If your provider only gives you one URL, set both to the same value.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# Random secret used to encrypt session cookies. Generate your own with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-random-64-char-hex-string"

# Passcode used once, by whoever signs up first, to become the pool admin.
# Change this before you deploy and share the link.
ADMIN_SETUP_CODE="change-me"

# Free API key from https://www.football-data.org/client/register - used to
# auto-sync Premier League fixtures/kickoffs/results into gameweeks you've
# already created (it never creates gameweeks itself).
FOOTBALL_DATA_API_KEY="replace-with-your-football-data-org-key"

# Random secret that authorizes the scheduled sync job. Generate your own with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Vercel Cron sends this automatically; only needed by hand if triggering the
# /api/cron/sync endpoint manually.
CRON_SECRET="replace-with-a-random-secret"
