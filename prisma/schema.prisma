generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Player {
  id           String      @id @default(cuid())
  name         String      @unique
  nameLower    String      @unique
  passcodeHash String
  isAdmin      Boolean     @default(false)
  paid         Boolean     @default(false)
  createdAt    DateTime    @default(now())
  picks        Pick[]
  chipUsages   ChipUsage[]
}

model Team {
  id           String    @id @default(cuid())
  name         String    @unique
  shortName    String    @unique
  // Common alternate names/nicknames (e.g. "Spurs", "Man City", "Palace") so
  // bulk-pasted fixtures from wherever match without needing the exact
  // official name or short code.
  aliases      String[]  @default([])
  crestUrl     String?
  // football-data.org's numeric team id, once resolved - lets the fixture
  // sync job match teams reliably instead of by name every time.
  externalId   Int?      @unique
  picks        Pick[]
  homeFixtures Fixture[] @relation("HomeTeam")
  awayFixtures Fixture[] @relation("AwayTeam")
}

model Gameweek {
  id         String      @id @default(cuid())
  number     Int         @unique
  deadline   DateTime
  isLocked   Boolean     @default(false)
  // True for gameweeks the sync job created and still owns the deadline for
  // (kept at 2h before first kickoff, auto-adjusted if that shifts). Manually
  // creating a gameweek, or editing its deadline by hand, leaves this false so
  // the sync never overwrites an admin's own choice.
  autoManaged Boolean     @default(false)
  fixtures   Fixture[]
  picks      Pick[]
  chipUsages ChipUsage[]
}

model Fixture {
  id         String   @id @default(cuid())
  gameweekId String
  gameweek   Gameweek @relation(fields: [gameweekId], references: [id], onDelete: Cascade)
  homeTeamId String
  homeTeam   Team     @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeamId String
  awayTeam   Team     @relation("AwayTeam", fields: [awayTeamId], references: [id])
  kickoff    DateTime?
  homeGoals  Int?
  awayGoals  Int?
  played     Boolean  @default(false)

  @@unique([gameweekId, homeTeamId, awayTeamId])
}

enum ChipType {
  GAMBLE
  DOUBLE_UP
  CLEAN_SHEET
}

model ChipUsage {
  id         String   @id @default(cuid())
  playerId   String
  player     Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  chipType   ChipType
  gameweekId String
  gameweek   Gameweek @relation(fields: [gameweekId], references: [id], onDelete: Cascade)
  usedAt     DateTime @default(now())

  @@unique([playerId, chipType])
}

model Pick {
  id         String   @id @default(cuid())
  playerId   String
  player     Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  gameweekId String
  gameweek   Gameweek @relation(fields: [gameweekId], references: [id], onDelete: Cascade)
  teamId     String
  team       Team     @relation(fields: [teamId], references: [id])
  createdAt  DateTime @default(now())
  // True when the player missed the deadline and the system picked for them
  // (alphabetically-first remaining team). Scores zero no matter the result,
  // but still counts as used, same as any other pick.
  autoAssigned Boolean @default(false)

  // A player can never pick the same team twice across the whole pool.
  @@unique([playerId, teamId])
}

model PoolConfig {
  id           String @id @default("singleton")
  poolName     String @default("Premier League Pick'em")
  entryFeeEuro Int    @default(20)
  numGameweeks Int    @default(19)
  // JSON map of finishing position -> share of the pot, e.g. {"1":0.7,"2":0.2,"3":0.1}
  payoutSplit  String @default("{\"1\":0.7,\"2\":0.2,\"3\":0.1}")
}
